<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/color_primary">

    <!-- Content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinatorLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/color_primary"
        app:layout_constraintBottom_toTopOf="@id/player"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_primary"
            android:elevation="0dp"
            app:elevation="0dp">

            <!-- Основной контент профиля - будет скрываться -->
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsingToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="@color/color_primary"
                app:scrimAnimationDuration="600"
                android:background="@color/color_primary"
                android:elevation="0dp"
                app:elevation="0dp"
                app:expandedTitleGravity="top|start"
                app:expandedTitleTextColor="@android:color/transparent"
                app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
                app:statusBarScrim="@android:color/transparent">

                <!-- Content -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="0dp"
                    android:layout_marginTop="5dp"
                    android:paddingBottom="20dp"
                    android:background="@color/color_primary"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:layout_collapseMode="parallax">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="20dp"
                        android:background="@color/color_primary">

                        <!-- Cover -->
                        <ImageView
                            android:id="@+id/group_cover"
                            android:layout_width="0dp"
                            android:layout_height="150dp"
                            android:scaleType="centerCrop"
                            android:background="@color/card"
                            android:adjustViewBounds="true"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Cover foreground -->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/coverForeground"
                            android:layout_width="0dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_top_account"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="@id/group_cover" />

                        <!-- Большая аватарка (круглая) - СДВИНУТА ВЛЕВО -->
                        <FrameLayout
                            android:id="@+id/avatar"
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            app:layout_constraintHorizontal_bias="0.05"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/coverForeground"
                            app:layout_constraintBottom_toTopOf="@id/coverForeground">

                            <RelativeLayout
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:background="@drawable/square"
                                android:orientation="horizontal">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/group_avatar"
                                    android:layout_width="90dp"
                                    android:layout_height="90dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/oval_account"
                                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CornerSize50Percent" />

                                <ImageView
                                    android:id="@+id/add_friend_icon"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginLeft="4dp"
                                    android:layout_gravity="center"
                                    android:visibility="gone"
                                    android:background="@drawable/check_circle" />
                            </RelativeLayout>
                        </FrameLayout>

                        <!-- Имя пользователя - СДВИНУТО ВЛЕВО -->
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/textViewName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="14dp"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Mad Cat"
                            android:textSize="20sp"
                            android:textAppearance="?android:textAppearanceMedium"
                            android:textColor="?android:textColorPrimary"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/avatar"
                            tools:text="Mad Cat" />

                        <!-- Verified иконка рядом с именем -->
                        <ImageView
                            android:id="@+id/verified_icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="14dp"
                            android:layout_gravity="center"
                            android:visibility="visible"
                            app:layout_constraintStart_toEndOf="@id/textViewName"
                            app:layout_constraintTop_toBottomOf="@id/avatar" />

                        <!-- Audio count (если нужен) -->
                        <TextView
                            android:id="@+id/audio_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="14dp"
                            android:visibility="gone"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:text="01/03"
                            app:layout_constraintStart_toEndOf="@id/verified_icon"
                            app:layout_constraintTop_toBottomOf="@id/avatar" />

                        <!-- Статус и ID - СДВИНУТЫ ВЛЕВО -->
                        <LinearLayout
                            android:id="@+id/players_artist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="left"
                            android:maxLines="1"
                            android:orientation="horizontal"
                            android:paddingBottom="5dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/textViewName"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="4dp"
                            tools:ignore="UseCompoundDrawables">

                            <TextView
                                android:id="@+id/artistsNamesText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:alpha="0.7"
                                android:text="В сети"
                                android:textAppearance="?android:textAppearanceSmall"
                                android:textColor="@color/black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="4dp"
                                android:layout_marginRight="4dp"
                                android:alpha="0.7"
                                android:text="•"
                                android:textAppearance="?android:textAppearanceSmall"
                                android:textColor="@color/black" />

                            <TextView
                                android:id="@+id/textViewId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:alpha="0.7"
                                android:text="ID: 123456789"
                                android:textAppearance="?android:textAppearanceSmall"
                                android:textColor="@color/black" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/textViewDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:visibility="visible"
                            android:alpha="0.7"
                            android:text="Подробнее"
                            android:textAppearance="?android:textAppearanceSmall"
                            android:textColor="@color/black"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/players_artist"
                            android:layout_marginTop="4dp" />

                        <!-- Статистика кнопки (4 в ряд) -->
                        <GridLayout
                            android:id="@+id/statsGrid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:columnCount="4"
                            android:rowCount="1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/textViewDescription"
                            android:layout_marginTop="16dp"
                            android:layout_marginHorizontal="16dp">

                            <!-- Кнопка друзей с счетчиком -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/friends_sum"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_row="0"
                                android:layout_column="0"
                                android:layout_rowWeight="1"
                                android:layout_columnWeight="1"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:text="Друзья\n0"
                                android:textColor="@color/black"
                                android:textSize="11sp"
                                android:gravity="center"
                                android:singleLine="false"
                                android:lines="2"
                                android:maxLines="2"
                                android:stateListAnimator="@null"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/item_friends"
                                app:iconGravity="textTop"
                                app:iconPadding="4dp"
                                app:iconSize="18dp"
                                app:iconTint="@color/black"
                                style="@style/Widget.Material3.Button.TextButton" />

                            <!-- Кнопка групп с счетчиком -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/groups_sum"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_row="0"
                                android:layout_column="1"
                                android:layout_rowWeight="1"
                                android:layout_columnWeight="1"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:text="Участники\n0"
                                android:textColor="@color/black"
                                android:textSize="11sp"
                                android:gravity="center"
                                android:singleLine="false"
                                android:lines="2"
                                android:maxLines="2"
                                android:stateListAnimator="@null"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/groups_24px"
                                app:iconGravity="textTop"
                                app:iconPadding="4dp"
                                app:iconSize="18dp"
                                app:iconTint="@color/black"
                                style="@style/Widget.Material3.Button.TextButton" />

                            <!-- Кнопка музыки с счетчиком -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/music_sum"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_row="0"
                                android:layout_column="2"
                                android:layout_rowWeight="1"
                                android:layout_columnWeight="1"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:text="Музыка\n0"
                                android:textColor="@color/black"
                                android:textSize="11sp"
                                android:gravity="center"
                                android:singleLine="false"
                                android:lines="2"
                                android:maxLines="2"
                                android:stateListAnimator="@null"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/music_note_outline"
                                app:iconGravity="textTop"
                                app:iconPadding="4dp"
                                app:iconSize="18dp"
                                app:iconTint="@color/black"
                                style="@style/Widget.Material3.Button.TextButton" />

                            <!-- Кнопка подписчиков с счетчиком -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/followers_sum"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_row="0"
                                android:layout_column="3"
                                android:layout_rowWeight="1"
                                android:layout_columnWeight="1"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:visibility="gone"
                                android:text="Подписчики\n0"
                                android:textColor="@color/black"
                                android:textSize="11sp"
                                android:gravity="center"
                                android:singleLine="false"
                                android:lines="3"
                                android:maxLines="3"
                                android:stateListAnimator="@null"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/groups_24px"
                                app:iconGravity="textTop"
                                app:iconPadding="4dp"
                                app:iconSize="18dp"
                                app:iconTint="@color/black"
                                style="@style/Widget.Material3.Button.TextButton" />

                        </GridLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- Toolbar -->
                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:layout_collapseMode="pin"
                    app:navigationIcon="@drawable/circle_back"
                    app:menu="@menu/menu_account"
                    app:title="Профиль" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/toolbar_avatar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:visibility="invisible"
                    android:alpha="0"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CornerSize10Percent" />

            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <!-- Action buttons (Написать, Подписаны и т.д.) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/color_primary"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                app:layout_scrollFlags="scroll|enterAlways|enterAlwaysCollapsed">

                <GridLayout
                    android:id="@+id/actionsGridLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Кнопка сообщения -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWriteMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="@color/bg_tab"
                        android:text="Написать"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:stateListAnimator="@null"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/chat_outline"
                        app:iconGravity="textTop"
                        app:iconPadding="8dp"
                        app:iconSize="20dp"
                        app:iconTint="@color/black"
                        style="@style/Widget.Material3.Button.TextButton" />

                    <!-- Кнопка редактирования (вместо поделиться) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/check"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="@color/bg_tab"
                        android:visibility="visible"
                        android:text="Подписаны"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:stateListAnimator="@null"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/account_multiple_check_outline"
                        app:iconGravity="textTop"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/black"
                        style="@style/Widget.Material3.Button.TextButton" />

                    <!-- Кнопка звука -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/music"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="@color/bg_tab"
                        android:text="Звук"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:stateListAnimator="@null"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/bell_outline"
                        app:iconGravity="textTop"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/black"
                        style="@style/Widget.Material3.Button.TextButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/menu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="@color/bg_tab"
                        android:visibility="visible"
                        android:text="Еще"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:stateListAnimator="@null"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/dots_horizontal"
                        app:iconGravity="textTop"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/black"
                        style="@style/Widget.Material3.Button.TextButton" />

                </GridLayout>
            </LinearLayout>

            <!-- TabLayout -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@color/color_primary"
                android:paddingLeft="0dp"
                android:paddingRight="2dp"
                android:textDirection="locale"
                app:contentScrim="@color/color_primary"
                app:layout_scrollFlags="scroll|enterAlways|enterAlwaysCollapsed"
                app:tabBackground="@color/color_primary"
                app:tabGravity="fill"
                app:tabIndicator="@drawable/selected_chip_background"
                app:tabIndicatorColor="@color/bg_tab"
                app:tabIndicatorFullWidth="true"
                app:tabIndicatorGravity="stretch"
                app:tabIndicatorHeight="2dp"
                app:tabMode="fixed"
                app:tabSelectedTextColor="?colorAccent"
                app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ФОТО" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ПОСТЫ" />

            </com.google.android.material.tabs.TabLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1sp"
                android:alpha="0.1"
                android:background="@color/bg_view"
                app:layout_scrollFlags="scroll|enterAlways" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <FrameLayout
            android:id="@+id/progressBarContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_primary"
            android:elevation="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/playlistIsEmptyText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_primary"
            android:gravity="center"
            android:text="Пусто"
            android:textColor="#000"
            android:textSize="18sp"
            android:visibility="gone" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Bottom player -->
    <LinearLayout
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="Orientation" />

</androidx.constraintlayout.widget.ConstraintLayout>